{
  "expo": {
    "name": "Digital Brain",
    "slug": "digital-brain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.googleusercontent.apps.000000000000-redacted-oauth-ios-1",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff2e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appcalipse.digitalbrain"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "androidStatusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#f7f2ec"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-fg.png",
        "backgroundImage": "./assets/images/android-icon-bg.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.appcalipse.digitalbrain",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      ["@react-native-google-signin/google-signin", {
        "iosUrlScheme": "com.googleusercontent.apps.000000000000-redacted-oauth-ios-2"
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "your-expo-owner"
  }
}
