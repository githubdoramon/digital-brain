{
  "expo": {
    "name": "Digital Brain",
    "slug": "digital-brain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.googleusercontent.apps.000000000000-redacted-oauth-ios-1",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff2e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appcalipse.digitalbrain",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Digital Brain uses your approximate location to answer context-aware questions.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Digital Brain uses your location in the background to keep place context up to date.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-fg.png",
        "backgroundImage": "./assets/images/android-icon-bg.png",
        "backgroundColor": "#F7F1EA",
        "monochromeImage": "./assets/images/android-icon-fg.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.appcalipse.digitalbrain",
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      ["expo-splash-screen", {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#fff2e8",
        "imageWidth": 150
      }],
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Digital Brain uses your photo library so you can attach event pictures and sync them to Immich."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "react-native-maps",
      ["@react-native-google-signin/google-signin", {
        "iosUrlScheme": "com.googleusercontent.apps.000000000000-redacted-oauth-ios-2"
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "your-expo-owner"
  }
}
