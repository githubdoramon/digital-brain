+package com.mentra.bluetoothsdk
+
+import android.content.Context
+import android.content.pm.PackageManager
+
+/** Opt-in host ownership prevents a second service and competing reconnect loops. */
+internal object ExternalConnectionOwner {
+    fun enabled(context: Context): Boolean = context.packageManager
+        .getApplicationInfo(context.packageName, PackageManager.GET_META_DATA)
+        .metaData?.getBoolean("com.mentra.bluetoothsdk.external_connection_owner", false) == true
+}
