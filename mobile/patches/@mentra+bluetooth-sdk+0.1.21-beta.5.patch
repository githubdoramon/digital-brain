+package com.mentra.bluetoothsdk
+
+import com.mentra.bluetoothsdk.services.ForegroundService
+import android.content.Context
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import android.media.MediaMuxer
+import android.media.MediaPlayer
+import android.net.Uri
+import android.os.Build
+import android.os.ParcelFileDescriptor
+import android.os.StatFs
+
+private const val RECORDING_PREFS = "mentra_glasses_audio_recording"
+private const val RECORDING_URI_KEY = "active_output_uri"
+private const val SAMPLE_RATE = 16_000
+private const val CHANNEL_COUNT = 1
+private const val PCM_BYTES_PER_SAMPLE = 2
+private const val MINIMUM_AVAILABLE_BYTES = 20L * 1024L * 1024L
+
+/**
+ * Receives Mentra's already-decoded 16-bit glasses PCM before it crosses the
+ * React Native event bridge.  The encoder and foreground service therefore
+ * keep working while the app UI is backgrounded or the phone is locked.
+ */
+object GlassesM4aRecorder {
+  private data class ActiveRecording(
+    val outputUri: String,
+    val descriptor: ParcelFileDescriptor,
+    val codec: MediaCodec,
+    val muxer: MediaMuxer,
+    val startedAtMs: Long,
+    var trackIndex: Int = -1,
+    var muxerStarted: Boolean = false,
+    var submittedSamples: Long = 0,
+    var inputBytes: Long = 0,
+  )
+
+  private var active: ActiveRecording? = null
+
+  private fun contextPrefs(context: Context) =
+    context.getSharedPreferences(RECORDING_PREFS, Context.MODE_PRIVATE)
+
+  private fun startService(context: Context) {
+    ForegroundService.setFeature(context, "recording", true)
+  }
+
+  private fun stopService(context: Context) {
+    ForegroundService.setFeature(context, "recording", false)
+  }
+
+  private fun hasEnoughFreeSpace(context: Context): Boolean =
+    runCatching {
+      StatFs(context.filesDir.absolutePath).availableBytes >= MINIMUM_AVAILABLE_BYTES
+    }.getOrDefault(false)
+
+  @Synchronized
+  fun start(context: Context, outputUri: String): Map<String, Any> {
+    check(active == null) { "A Mentra Live recording is already in progress." }
+    check(hasEnoughFreeSpace(context)) { "Digital Brain needs at least 20 MB of free storage to record audio." }
+    val uri = Uri.parse(outputUri)
+    val descriptor = context.contentResolver.openFileDescriptor(uri, "rw")
+      ?: throw IllegalArgumentException("Digital Brain cannot write to the selected recording file.")
+    try {
+      val codec = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_AUDIO_AAC)
+      val format = MediaFormat.createAudioFormat(MediaFormat.MIMETYPE_AUDIO_AAC, SAMPLE_RATE, CHANNEL_COUNT)
+      format.setInteger(MediaFormat.KEY_AAC_PROFILE, MediaCodecInfo.CodecProfileLevel.AACObjectLC)
+      format.setInteger(MediaFormat.KEY_BIT_RATE, 48_000)
+      format.setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, 16 * 1024)
+      codec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+      codec.start()
+      val muxer = MediaMuxer(descriptor.fileDescriptor, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+      active = ActiveRecording(outputUri, descriptor, codec, muxer, System.currentTimeMillis())
+      contextPrefs(context).edit().putString(RECORDING_URI_KEY, outputUri).apply()
+      startService(context)
+      return mapOf("outputUri" to outputUri, "startedAt" to System.currentTimeMillis())
+    } catch (error: Throwable) {
+      descriptor.close()
+      context.contentResolver.delete(uri, null, null)
+      throw error
+    }
+  }
+
+  @Synchronized
+  fun status(): Map<String, Any?> = active?.let {
+    mapOf("recording" to true, "outputUri" to it.outputUri, "startedAt" to it.startedAtMs)
+  } ?: mapOf("recording" to false, "outputUri" to null, "startedAt" to null)
+
+  @Synchronized
+  fun offer(context: Context, event: MicPcmEvent): Map<String, Any>? {
+    val recording = active ?: return null
+    if (!hasEnoughFreeSpace(context)) return finish(context, "low_storage")
+    if (
+      event.sampleRate != SAMPLE_RATE ||
+      event.channels != CHANNEL_COUNT ||
+      event.bitsPerSample != PCM_BYTES_PER_SAMPLE * 8 ||
+      event.encoding != "pcm_s16le"
+    ) {
+      return null
+    }
+    var offset = 0
+    while (offset < event.pcm.size) {
+      drain(recording, false)
+      val inputIndex = recording.codec.dequeueInputBuffer(10_000)
+      if (inputIndex < 0) return null
+      val input = recording.codec.getInputBuffer(inputIndex) ?: return null
+      input.clear()
+      val count = minOf(input.remaining(), event.pcm.size - offset)
+      input.put(event.pcm, offset, count)
+      val presentationTimeUs = recording.submittedSamples * 1_000_000L / SAMPLE_RATE
+      recording.codec.queueInputBuffer(inputIndex, 0, count, presentationTimeUs, 0)
+      recording.submittedSamples += count / PCM_BYTES_PER_SAMPLE
+      recording.inputBytes += count
+      offset += count
+    }
+    return null
+  }
+
+  private fun drain(recording: ActiveRecording, endOfStream: Boolean) {
+    val info = MediaCodec.BufferInfo()
+    var idlePasses = 0
+    while (idlePasses < if (endOfStream) 60 else 1) {
+      when (val outputIndex = recording.codec.dequeueOutputBuffer(info, if (endOfStream) 10_000 else 0)) {
+        MediaCodec.INFO_TRY_AGAIN_LATER -> {
+          idlePasses += 1
+          if (!endOfStream) return
+        }
+        MediaCodec.INFO_OUTPUT_FORMAT_CHANGED -> {
+          check(!recording.muxerStarted) { "Audio encoder changed format twice." }
+          recording.trackIndex = recording.muxer.addTrack(recording.codec.outputFormat)
+          recording.muxer.start()
+          recording.muxerStarted = true
+        }
+        else -> if (outputIndex >= 0) {
+          val output = recording.codec.getOutputBuffer(outputIndex)
+            ?: throw IllegalStateException("Audio encoder output buffer is unavailable.")
+          if (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG == 0 && info.size > 0) {
+            check(recording.muxerStarted && recording.trackIndex >= 0) { "Audio muxer is not ready." }
+            output.position(info.offset)
+            output.limit(info.offset + info.size)
+            recording.muxer.writeSampleData(recording.trackIndex, output, info)
+          }
+          recording.codec.releaseOutputBuffer(outputIndex, false)
+          if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) return
+          idlePasses = 0
+        }
+      }
+    }
+  }
+
+  @Synchronized
+  fun finish(context: Context, reason: String): Map<String, Any>? {
+    val recording = active ?: return null
+    active = null
+    var completed = false
+    try {
+      var inputIndex = recording.codec.dequeueInputBuffer(20_000)
+      var retries = 0
+      while (inputIndex < 0 && retries < 5) {
+        drain(recording, false)
+        inputIndex = recording.codec.dequeueInputBuffer(20_000)
+        retries += 1
+      }
+      if (inputIndex >= 0) {
+        recording.codec.queueInputBuffer(
+          inputIndex,
+          0,
+          0,
+          recording.submittedSamples * 1_000_000L / SAMPLE_RATE,
+          MediaCodec.BUFFER_FLAG_END_OF_STREAM,
+        )
+        drain(recording, true)
+      }
+      completed = recording.muxerStarted && recording.inputBytes > 0
+      if (recording.muxerStarted) recording.muxer.stop()
+    } catch (_: Throwable) {
+      completed = false
+    } finally {
+      runCatching { recording.codec.stop() }
+      runCatching { recording.codec.release() }
+      runCatching { recording.muxer.release() }
+      runCatching { recording.descriptor.close() }
+      contextPrefs(context).edit().remove(RECORDING_URI_KEY).apply()
+      stopService(context)
+    }
+    if (!completed) {
+      context.contentResolver.delete(Uri.parse(recording.outputUri), null, null)
+      return mapOf("completed" to false, "reason" to reason, "outputUri" to recording.outputUri)
+    }
+    return mapOf(
+      "completed" to true,
+      "reason" to reason,
+      "outputUri" to recording.outputUri,
+      "durationMs" to (recording.submittedSamples * 1_000L / SAMPLE_RATE),
+      "sizeBytes" to recording.inputBytes,
+      "startedAt" to recording.startedAtMs,
+    )
+  }
+
+  @Synchronized
+  fun recoverInterrupted(context: Context): Map<String, Any>? {
+    if (active != null) return null
+    val uriString = contextPrefs(context).getString(RECORDING_URI_KEY, null) ?: return null
+    contextPrefs(context).edit().remove(RECORDING_URI_KEY).apply()
+    val uri = Uri.parse(uriString)
+    val playable = runCatching {
+      val extractor = MediaExtractor()
+      try {
+        extractor.setDataSource(context, uri, emptyMap())
+        (0 until extractor.trackCount).any { index ->
+          extractor.getTrackFormat(index).getString(MediaFormat.KEY_MIME)?.startsWith("audio/") == true
+        }
+      } finally {
+        extractor.release()
+      }
+    }.getOrDefault(false)
+    if (!playable) {
+      context.contentResolver.delete(uri, null, null)
+    }
+    return mapOf("outputUri" to uriString, "recovered" to playable)
+  }
+}
+
+object GlassesM4aPlayback {
+  private var player: MediaPlayer? = null
+
+  @Synchronized
+  fun play(context: Context, uriString: String, onFinished: () -> Unit): Map<String, Any> {
+    stop()
+    val next = MediaPlayer()
+    try {
+      next.setDataSource(context, Uri.parse(uriString))
+      next.setOnCompletionListener { completed ->
+        synchronized(this) {
+          if (player === completed) {
+            stop()
+            onFinished()
+          }
+        }
+      }
+      next.setOnErrorListener { failed, _, _ ->
+        synchronized(this) {
+          if (player === failed) {
+            stop()
+            onFinished()
+          }
+        }
+        true
+      }
+      next.prepare()
+      player = next
+      next.start()
+      return mapOf("playing" to true, "durationMs" to next.duration)
+    } catch (error: Throwable) {
+      if (player === next) player = null
+      runCatching { next.release() }
+      throw error
+    }
+  }
+
+  @Synchronized
+  fun stop(): Map<String, Any> {
+    val current = player ?: return mapOf("playing" to false)
+    player = null
+    runCatching { current.stop() }
+    current.release()
+    return mapOf("playing" to false)
+  }
+}
