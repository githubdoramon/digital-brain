@@ -0,0 +1,38 @@
+package com.mentra.bluetoothsdk.sgcs
+
+/** Monotonic, bounded ASG liveness tracking; BES heartbeats/audio do not prove ASG health. */
+internal class ControlPlaneWatchdog(private val timeoutMs: Long = 90_000L) {
+    private var lastReplyMs = 0L
+    private var probes = 0
+    private var reported = false
+    private var armed = false
+
+    @Synchronized fun reset(nowMs: Long) {
+        lastReplyMs = nowMs
+        probes = 0
+        reported = false
+        armed = false
+    }
+
+    @Synchronized fun pong(nowMs: Long) {
+        lastReplyMs = nowMs
+        probes = 0
+        // Require a demonstrated pong on this session; legacy firmware must
+        // never enter a reconnect loop just because it cannot answer ping.
+        armed = true
+    }
+
+    @Synchronized fun probe(nowMs: Long, suppressed: Boolean): Boolean {
+        if (suppressed) {
+            reset(nowMs)
+            return false
+        }
+        if (!armed || reported) return false
+        if (probes >= 3 && nowMs - lastReplyMs >= timeoutMs) {
+            reported = true
+            return true
+        }
+        probes++
+        return false
+    }
+}
