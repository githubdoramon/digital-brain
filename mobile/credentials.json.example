{
  "_comment": "Copy to credentials.json and fill in your own keystore details. credentials.json is gitignored. Prefer EAS managed credentials or env-var-driven signing over committing this file.",
  "android": {
    "keystore": {
      "keystorePath": "credentials/android/keystore.jks",
      "keystorePassword": "REPLACE_WITH_YOUR_KEYSTORE_PASSWORD",
      "keyAlias": "REPLACE_WITH_YOUR_KEY_ALIAS"
    }
  }
}
