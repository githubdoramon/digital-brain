{
  "name": "mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "prebuild": "expo prebuild --clean",
    "start": "APP_VARIANT=development expo start",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "APP_VARIANT=development expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:background-runtime": "node scripts/test-background-runtime.cjs",
    "test:proposal-actions": "node --test scripts/test-proposal-actions.cjs",
    "eas:build:android:apk": "source .env; set +a; bash ./scripts/eas-build-android-apk.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@mentra/bluetooth-sdk": "3.2.1",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/native": "^7.5.1",
    "@siteed/audio-studio": "^3.1.1",
    "buffer": "^6.0.3",
    "expo": "^55.0.31",
    "expo-application": "~55.0.19",
    "expo-asset": "~55.0.17",
    "expo-background-task": "~55.0.22",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.8",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.24",
    "expo-intent-launcher": "~55.0.16",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-media-library": "~55.0.21",
    "expo-modules-core": "55.0.26",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.12",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.5",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "13.17.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.2.9",
    "typescript": "~5.9.2"
