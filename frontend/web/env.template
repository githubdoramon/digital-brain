# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-auth-secret-here

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID is the OAuth web client used by NextAuth.
# If omitted, the first GOOGLE_CLIENT_IDS entry is used for compatibility with backend config.
GOOGLE_CLIENT_ID=your-google-client-id-here
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,mobile-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Browser Google Maps JavaScript API key for /timeline.
# Enable Maps JavaScript API and restrict this key to your web origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key-here

# App URL (used for OAuth callbacks)
# In production, set this to your actual domain
NEXTAUTH_URL=http://localhost:3000

# Internal backend service URLs (used by Next.js proxy routes)
# When running with docker-compose, these resolve via the compose service DNS names
BACKEND_API_BASE=http://localhost:8000
ROBOT_GATEWAY_API_BASE=http://localhost:8001

# Service-to-service API key (used by server-side proxy routes)
ORCHESTRATOR_API_KEY=change-me

# Required: comma-separated email allowlist. Empty is rejected at startup.
ALLOWED_USERS=user@example.com

# Build metadata (populated automatically during CI/CD)
NEXT_PUBLIC_APP_VERSION=dev
NEXT_PUBLIC_APP_BUILD_TIME=2024-01-01T00:00:00Z
NEXT_PUBLIC_APP_GIT_SHA=local
NEXT_PUBLIC_APP_DEPLOYMENT=local
