# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-auth-secret-here

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# App URL (used for OAuth callbacks)
# In production, set this to your actual domain
NEXTAUTH_URL=http://localhost:3000

# Internal backend service URLs (used by Next.js proxy routes)
# When running with docker-compose, these resolve via the compose service DNS names
BACKEND_API_BASE=http://localhost:8000
ROBOT_GATEWAY_API_BASE=http://localhost:8001

# Service-to-service API key (used by server-side proxy routes)
ORCHESTRATOR_API_KEY=change-me

# User allowlist (optional) - comma-separated emails, empty = allow all
ALLOWED_USERS=

# Build metadata (populated automatically during CI/CD)
NEXT_PUBLIC_APP_VERSION=dev
NEXT_PUBLIC_APP_BUILD_TIME=2024-01-01T00:00:00Z
NEXT_PUBLIC_APP_GIT_SHA=local
NEXT_PUBLIC_APP_DEPLOYMENT=local
