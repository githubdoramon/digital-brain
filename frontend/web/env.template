# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-auth-secret-here

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# App URL (used for OAuth callbacks)
# In production, set this to your actual domain
NEXTAUTH_URL=http://localhost:3000

# Internal backend service URLs (used by Next.js proxy routes)
# When running with docker-compose, these resolve via the compose service DNS names
BACKEND_API_BASE=http://localhost:8000
REMOVED_SERVICE_BASE=http://removed_service:7001

# User allowlist (optional) - comma-separated emails, empty = allow all
ALLOWED_USERS=

# Deployment webhook (used by /api/deploy)
# Shared secret required in the X-Deploy-Key header
DEPLOY_WEBHOOK_KEY=replace-with-strong-secret
# Absolute path to the deployment script executable inside the runtime container/host
DEPLOY_SCRIPT_PATH=/opt/app/scripts/redeploy.sh
# Optional timeout in milliseconds (set to 0 or omit to disable)
DEPLOY_SCRIPT_TIMEOUT_MS=900000

