# PostgreSQL initialization variables (required by the container)
POSTGRES_USER=memuser
POSTGRES_PASSWORD=mempass
POSTGRES_DB=memdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public
# Auto-apply SQL migrations from backend/orchestrator/db_migrations on startup
# DB_AUTO_MIGRATE=true
# DB_AUTO_MIGRATE_FAIL_FAST=true

# Daily encrypted PostgreSQL backup to S3 (worker runs at 00:00 Europe/Lisbon)
DB_BACKUP_PASSPHRASE=
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_PREFIX=
# AWS_DEFAULT_REGION=eu-west-1
# Optional database overrides; defaults to POSTGRES_USER and POSTGRES_DB
# DB_BACKUP_POSTGRES_USER=
# DB_BACKUP_POSTGRES_DB=

# Timezone
TZ=UTC

# LLM Configuration (OpenAI-compatible API)
# For Ollama: use http://host.docker.internal:11434/v1 (or your Ollama host + /v1)
# For OpenAI: use https://api.openai.com/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_CHAT_MODEL_FAST=llama3.2:3b-instruct-q4_K_M
LLM_CHAT_MODEL_SMART=llama3:70b-instruct
# Optional multimodal model for image/PDF inspection; defaults to LLM_CHAT_MODEL_SMART.
LLM_CHAT_MODEL_VISION=
OLLAMA_CHAT_KEEP_ALIVE=-1
LLM_TIMEOUT=180
# Minimum read timeouts for reasoning calls, including callers with shorter defaults.
LLM_REASONING_TIMEOUT=300
LLM_HIGH_REASONING_TIMEOUT=900
# Best-effort background model warm-up, separate from normal/reasoning requests.
LLM_WARMUP_TIMEOUT=180
# Optional provider output ceiling, including reasoning tokens (0 means unspecified).
LLM_MAX_OUTPUT_TOKENS=0
# Shared preflight for all chat-completion calls; input + output share this window.
# Text uses a local BPE estimate with 20% headroom, plus the context margin.
LLM_CONTEXT_WINDOW_TOKENS=65536
LLM_CONTEXT_MARGIN_TOKENS=4096
LLM_DEFAULT_MAX_OUTPUT_TOKENS=8192
LLM_REASONING_MAX_OUTPUT_TOKENS=12000
# Optional per-model window overrides (otherwise use the shared window).
# LLM_CONTEXT_WINDOW_FAST_TOKENS=65536
# LLM_CONTEXT_WINDOW_SMART_TOKENS=65536
# LLM_CONTEXT_WINDOW_VISION_TOKENS=65536
# Per-image estimate; vision token costs depend on the provider and image size.
LLM_IMAGE_INPUT_TOKENS=8192
# Detailed source/model/validation logs in the local authenticated system log.
# Credentials remain redacted; none of this detail is exported to telemetry.
LLM_DIAGNOSTICS_ENABLED=true
LLM_DIAGNOSTIC_MAX_CHARS=60000
# Intelligence shares a combined context window between input and generated tokens.
# Input uses the shared token estimate, including envelope and response schema.
KNOWLEDGE_CONTEXT_WINDOW_TOKENS=65536
KNOWLEDGE_CONTEXT_MARGIN_TOKENS=4096
KNOWLEDGE_MAX_OUTPUT_TOKENS=20000

# Embeddings (llama.cpp OpenAI-compatible API; /v1 is added when omitted)
EMBEDDINGS_HOST=http://host.docker.internal:8080
EMBEDDINGS_MODEL=nomic-embed-text:latest
EMBEDDINGS_API_KEY=
# Retained for compatibility with existing embedding configuration.
EMBEDDINGS_MAX_INPUT_TOKENS=2048
# Hard safety cap before embedding requests (UTF-8 bytes)
# Applied before sending requests to llama.cpp.
EMBEDDINGS_MAX_INPUT_BYTES=3000

# User auth
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,mobile-client-id.apps.googleusercontent.com
# Required: comma-separated allowlist. Empty is rejected at startup.
ALLOWED_USERS=user@example.com

# Service-to-service auth
ORCHESTRATOR_API_KEY=change-me

# Internet search (LangSearch)
# Obtain an API key from https://langsearch.com/dashboard and set it here to enable the LLM web search tool
LANGSEARCH_API_KEY=
# Optional overrides:
# LANGSEARCH_API_URL=https://api.langsearch.com/v1/web-search
