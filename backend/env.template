# PostgreSQL initialization variables (required by the container)
POSTGRES_USER=memuser
POSTGRES_PASSWORD=mempass
POSTGRES_DB=memdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

# Timezone
TZ=UTC

# LLM Configuration (OpenAI-compatible API)
# For Ollama: use http://host.docker.internal:11434/v1 (or your Ollama host + /v1)
# For OpenAI: use https://api.openai.com/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_CHAT_MODEL=llama3:70b-instruct
LLM_TIMEOUT=120

# Embeddings (uses Ollama directly - not OpenAI compatible yet)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# User auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_USERS=

# Service-to-service auth
ORCHESTRATOR_API_KEY=change-me

# Internet search (Tavily)
# Obtain an API key from https://tavily.com and set it here to enable the LLM web search tool
TAVILY_API_KEY=
# Optional overrides:
# TAVILY_API_URL=https://api.tavily.com/search
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_TIMEOUT=30
# TAVILY_EXTRACT_URL=https://api.tavily.com/extract
# TAVILY_EXTRACT_TIMEOUT=30
# TAVILY_EXTRACT_INCLUDE_LINKS=false
# TAVILY_EXTRACT_INCLUDE_IMAGES=false
# TAVILY_EXTRACT_INCLUDE_HTML=false
# TAVILY_EXTRACT_MAX_CHARACTERS=20000

CURRENT_USER_INFO={"name": "Your Name", "email": "your.email@example.com"}

# Document storage
DOCUMENT_STORAGE_DIR=/app/storage/documents
# DOCUMENT_LABEL_MAX_COUNT=5

# Telegram bot + Immich photo ingest
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to upload (leave blank to allow all)
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: token sent in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
IMMICH_SERVER_URL=
IMMICH_API_KEY=
# Optional identifier that will appear in Immich as the "device"
IMMICH_DEVICE_ID=telegram-bot
# Optional overrides for request timeouts (seconds)
# TELEGRAM_HTTP_TIMEOUT=20
# IMMICH_HTTP_TIMEOUT=45

IMMICH_FACE_API_KEY=

HA_URL=http://192.168.1.100:8123
HA_TOKEN=something

