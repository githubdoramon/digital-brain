# Database config
POSTGRES_USER=memuser
POSTGRES_PASSWORD=mempass
POSTGRES_DB=memdb

# Database connection string (used by services)
DB_DSN=postgresql://memuser:mempass@db:5432/memdb

# Qdrant config
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Timezone
TZ=UTC

# Ollama config (local embeddings + chat)
# Use host.docker.internal to access Ollama running on your Mac/Windows host
# On Linux, you may need to use your actual IP address instead
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct

