# Immich integration
IMMICH_SERVER_URL=
IMMICH_API_KEY=
# Optional upload device label sent to Immich
IMMICH_DEVICE_ID=
# Glasses media sync: ID of an existing Immich album (required unless its unique name is set below).
# Uses IMMICH_SERVER_URL and IMMICH_API_KEY above; does not create albums.
GLASSES_IMMICH_ALBUM_ID=
# Optional fallback: exact existing album name; must match only one album. ID takes precedence.
GLASSES_IMMICH_ALBUM_NAME=
# Original-media upload staging directory. Custom paths require a matching persistent volume mount.
GLASSES_MEDIA_UPLOAD_DIR=storage/glasses-media
# Optional overrides for request timeouts (seconds)
# IMMICH_HTTP_TIMEOUT=45

HA_URL=
HA_TOKEN=
# Fixed glasses gate commands: existing script.* entity IDs, not Digital Brain command IDs
# (open_front_gate/toggle_car_gate) or hexadecimal device-action registry IDs.
GLASSES_FRONT_GATE_SCRIPT=
GLASSES_CAR_GATE_SCRIPT=
# Durable at-most-once dispatch receipts; custom paths need a persistent volume.
GLASSES_COMMAND_RECEIPT_DIR=storage/glasses-commands
